DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Set for PostgreSQL, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Brevo (https://www.brevo.com) sends enquiry notification emails over HTTPS —
# Render's free tier blocks outbound SMTP, so Gmail SMTP can't be used there.
# DEFAULT_FROM_EMAIL must be a sender verified in the Brevo dashboard.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
SHOP_NOTIFICATION_EMAIL=
